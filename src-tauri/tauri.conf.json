{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Engineers' Circuit Workbench",
  "version": "0.2.0",
  "identifier": "io.github.zvladimir.ecw",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "ECW — Engineers' Circuit Workbench",
        "width": 1024,
        "height": 700,
        "minWidth": 820,
        "minHeight": 620,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.png", "icons/icon.ico"]
  }
}
